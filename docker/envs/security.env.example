# ------------------------------
# Sign-in with Microsoft Entra ID (Azure AD) SSO and workspaces
# ------------------------------
# Register an app in the Entra admin center with a redirect URI of
# <CONSOLE_API_URL>/console/api/oauth/authorize/azure, then fill these in.
# AZURE_CLIENT_ID=your-app-registration-client-id
# AZURE_CLIENT_SECRET=your-app-registration-client-secret
# 'common' allows any Entra tenant; set a tenant id to restrict sign-in to your organization.
# Only set a tenant id you control: with 'common', Entra issues tokens from any tenant and the
# email claim is authoritative only for a tenant your organization manages.
# AZURE_TENANT_ID=common
# The "Sign in with Microsoft" button appears automatically once the client id and secret
# are set. Only set ENABLE_SOCIAL_OAUTH_LOGIN to false to hide all social sign-in buttons.
# ENABLE_SOCIAL_OAUTH_LOGIN=true
# Allow Entra users to create their Dify account on first sign-in (default: false, which
# requires inviting them to a workspace first).
# ALLOW_REGISTER=true
# Multi-workspace is enabled by default; set ALLOW_CREATE_WORKSPACE=false to lock users to
# invited workspaces only.
# ALLOW_CREATE_WORKSPACE=true
